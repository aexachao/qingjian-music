{
  "expo": {
    "name": "轻简音乐",
    "slug": "qingjian-music",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icons/ios/crimson-bars.png",
    "scheme": "qingjianmusic",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0f0f0f",
    "ios": {
      "bundleIdentifier": "com.chrisli.music",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDisplayName": "轻简音乐",
        "UIBackgroundModes": ["audio"],
        "NSLocalNetworkUsageDescription": "用于连接局域网内的飞牛音乐服务器，读取你的音乐库并播放。",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.chrisli.music",
      "adaptiveIcon": {
        "backgroundColor": "#f62c55",
        "foregroundImage": "./assets/images/app-icons/android/crimson-bars-foreground.png",
        "monochromeImage": "./assets/images/app-icons/android/crimson-bars-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/MaterialIcons.ttf",
            "./assets/fonts/Montserrat-Regular.ttf",
            "./assets/fonts/Montserrat-Medium.ttf",
            "./assets/fonts/Montserrat-SemiBold.ttf",
            "./assets/fonts/Montserrat-Bold.ttf"
          ]
        }
      ],
      [
        "./plugins/with-ios-signing",
        {
          "teamId": "4NJM425J3B"
        }
      ],
      "./plugins/with-ios-ldflags-dedupe",
      "./plugins/with-app-icons",
      "./plugins/with-android-cleartext",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f0f0f",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
